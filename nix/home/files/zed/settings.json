{
  "ui_font_weight": 300.0,
  "buffer_font_weight": 320.0,
  "buffer_font_family": "CaskaydiaCove Nerd Font Mono",
  "ui_font_family": "CaskaydiaCove Nerd Font Mono",
  "agent_servers": {
    "opencode": {
      "favorite_config_option_values": {
        "effort": [
          "xhigh"
        ],
        "model": [
          "openai/gpt-5.5"
        ]
      },
      "type": "registry",
      "env": {
        "OPENCODE_DB": "opencode.db",
      },
    },
  },
  "diff_view_style": "unified",
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "dock": "right",
  },
  "show_wrap_guides": true,
  "project_panel": {
    "dock": "right",
  },
  "debugger": {
    "dock": "right",
  },
  "git_panel": {
    "tree_view": true,
    "dock": "right",
    "sort_by_path": false,
  },
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:11434",
    },
  },
  "disable_ai": false,
  "show_edit_predictions": false,
  "edit_predictions": {
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
      "enterprise_uri": null,
    },
  },
  "terminal": {
    "font_weight": 450.0,
    "font_size": 14.0,
    "font_family": "CaskaydiaCove Nerd Font",
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "icon_theme": "JetBrains Icons Dark",
  "vim_mode": true,
  "agent": {
    "enable_feedback": false,
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "provider": "x_ai",
      "model": "grok-code-fast-1",
    },
  },
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "One Dark",
    "dark": "Kanagawa Wave",
  },
  "lsp": {
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "customTags": ["!override sequence", "!reset sequence"],
        },
      },
    },
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "tabs": {
    "activate_on_close": "neighbour",
  },
}
