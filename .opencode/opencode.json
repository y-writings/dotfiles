{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "*sudo *": "ask",
      "*darwin-rebuild *switch*": "ask",
      "*home-manager *switch*": "ask",
      "*mise *run *rebuild*": "ask",
      "*nix *run *nix-darwin*switch*": "ask",
      "*brew *install*": "ask",
      "*brew *uninstall*": "ask",
      "*brew *remove*": "ask",
      "*brew *rm *": "ask",
      "*brew *upgrade*": "ask",
      "*nix *profile *install*": "ask",
      "*nix *profile *remove*": "ask",
      "*nix-env *-i*": "ask",
      "*nix-env *-e*": "ask",
      "*npm *install*-g*": "ask",
      "*npm *install*--global*": "ask",
      "*npm *uninstall*-g*": "ask",
      "*npm *uninstall*--global*": "ask",
      "*pnpm *add*-g*": "ask",
      "*pnpm *add*--global*": "ask",
      "*pnpm *remove*-g*": "ask",
      "*pnpm *remove*--global*": "ask",
      "*mise *install*": "ask",
      "*mise *uninstall*": "ask"
    }
  }
}
